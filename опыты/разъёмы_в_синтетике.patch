+def connector(sh, cx, cy, side, v):
+    """Разъём/клемма (на плате — деталь J) разных видов, как рисуют в книгах и на сайтах: стрелка «<»,
+    наконечник «→», кружок малый/большой, «Ø», залитая точка, треугольник, гнездо «)», черта «⊤» с подписью.
