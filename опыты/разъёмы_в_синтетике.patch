+        a0 = (-60 if s > 0 else 120) + (90 if vertical else 0)
+        cv2.ellipse(sh.img, (int(cc[0]), int(cc[1])), (r, r), 0, a0, a0 + 120, INK, t, cv2.LINE_AA)
+        attach = (cx, cy)
