+        a = 10 + v.randint(0, 6)
+        attach = (cx, cy)
+        sh.line(L(attach), L((cx - s * a, cy - a)))
+        sh.line(L(attach), L((cx - s * a, cy + a)))
+        body = [(cx - s * a, cy - a), (cx, cy + a)]
+    elif shape == "plug":                                # наконечник: залитая стрелка, остриё от провода
+        a = 9 + v.randint(0, 5)
+        tip = np.array([L((cx - s * a, cy)), L((cx, cy - a * 0.6)), L((cx, cy + a * 0.6))], np.int32)
+        cv2.fillPoly(sh.img, [tip], INK, cv2.LINE_AA)
+        attach = (cx, cy)
+        body = [(cx - s * a, cy - a * 0.6), (cx, cy + a * 0.6)]
+    elif shape in ("ring", "ringbig", "oslash", "dot"):
+        r = {"ring": 5 + v.randint(0, 2), "ringbig": 11 + v.randint(0, 5), "oslash": 8 + v.randint(0, 3),
+             "dot": 4 + v.randint(0, 2)}[shape]
+        cc = L((cx, cy))
+        cv2.circle(sh.img, (int(cc[0]), int(cc[1])), r, INK, -1 if shape == "dot" else t, cv2.LINE_AA)
+        if shape == "oslash":
+            sh.line(L((cx - r - 2, cy + r + 2)), L((cx + r + 2, cy - r - 2)))
